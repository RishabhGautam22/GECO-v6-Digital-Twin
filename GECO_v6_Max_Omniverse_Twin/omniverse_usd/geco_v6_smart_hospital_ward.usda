                custom string geco:patient_cohort = "SOC-06: Central Nursing & Cyber-Physical Command Center"
                custom string geco:active_scenario_code = "WARD_SOC_PTP_TELEMETRY_FUSION"
                custom string geco:active_scenario_name = "12-Cubicle Telemetry Aggregation, PTP Clock Sync & Root-Cause Attribution"
                custom string geco:scenario_category = "Ward-Wide Supervisory Control & Audit Logging"
                custom string geco:scenarios_tested_list = "IEEE1588_PTP_SYNC | MULTI_PATIENT_RISK_RANKING | PHYSICAL_VS_CYBER_SEPARATION | PAPER_REPORT_EXPORT"
