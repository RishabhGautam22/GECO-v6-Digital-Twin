                custom string geco:scenarios_tested_list = "C1_UNAUTH_10U_BOLUS_REPLAY | C2_FAKE_HYPO_CGM_SPOOF | C3_STEALTH_CUSUM_DRIP | SIMPLEX_PINCH_VALVE_CLAMP"
