    def Xform "Ward" (
        kind = "assembly"
    )
    {
        def Xform "Room_01_Nominal_Adult" (
            kind = "component"
        )
        {
            double3 xformOp:translate = (-6.000, -3.000, 0.000)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string geco:room_id = "ROOM_01"
            custom string geco:room_title = "Room 01 — Nominal Adult ICU (75 kg)"
            custom string geco:active_scenario_code = "NOMINAL_CLOSED_LOOP"
            custom string geco:active_scenario_name = "Nominal Closed-Loop & Meal Bolus Tracking"
            custom string geco:scenario_category = "Baseline Closed-Loop Control"
            custom string geco:scenarios_tested = "NOMINAL_CLOSED_LOOP | MEAL_75G_DISTURBANCE | EKF_30MIN_FORECAST | HOVORKA_RK4_INTEGRITY"

            def Xform "CubicleScenarioBoard" (
                doc = "3D Overhead Cubicle Scenario & Telemetry Signage Board Showing Active Scenario and Test Matrix"
            )
            {
                double3 xformOp:translate = (0.0, 2.16, 2.22)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                custom string geco:cubicle_id = "ROOM_01"
                custom string geco:patient_cohort = "P01: Adult T1D (75 kg, ISF=42 mg/dL/U)"
                custom string geco:active_scenario_code = "NOMINAL_CLOSED_LOOP"
                custom string geco:active_scenario_name = "Nominal Closed-Loop & Meal Bolus Tracking"
                custom string geco:scenario_category = "Baseline Closed-Loop Control"
                custom string geco:scenarios_tested_list = "NOMINAL_CLOSED_LOOP | MEAL_75G_DISTURBANCE | EKF_30MIN_FORECAST | HOVORKA_RK4_INTEGRITY"
                custom string geco:expected_safety_response = "EKF 30-min forecast tracks meal peak within 16.82 mg/dL RMSE; zero alarms"

                def Cube "BoardFrame" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1.0
                    float3 xformOp:scale = (2.10, 0.05, 0.56)
                    uniform token[] xformOpOrder = ["xformOp:scale"]
                    rel material:binding = </World/Looks/Mat_MatteDark>
                }
                def Cube "BoardScreenSurface" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
