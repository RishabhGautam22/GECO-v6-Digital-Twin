                    double size = 1.0
                    double3 xformOp:translate = (0.0, -0.028, 0.0)
                    float3 xformOp:scale = (2.02, 0.01, 0.48)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </World/Looks/Mat_ScreenTelemetry>
                }
                def Cube "ScenarioStatusBanner" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1.0
                    double3 xformOp:translate = (0.0, -0.036, 0.18)
                    float3 xformOp:scale = (1.96, 0.012, 0.09)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </World/Looks/Mat_BatteryHealthy>
                }
                def Cube "Bar_BG" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1.0
                    double3 xformOp:translate = (-0.55, -0.036, -0.05)
                    float3 xformOp:scale = (0.28, 0.015, 0.22)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </World/Looks/Mat_SalineTeal>
                }
                def Cube "Bar_Pressure" (
